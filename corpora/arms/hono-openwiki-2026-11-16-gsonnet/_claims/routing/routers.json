    },
    {
      "id": "claim_f28739d7b0fb487bb0c026ddde07c60f",
      "statement": "SmartRouter records routes until the first match, then tries candidate routers in order, falling back on UnsupportedPathError; the first success is locked in by rebinding match, discarding the other routers and recorded routes, and making later add calls throw.",
      "evidence": [
        {
          "resource": "repo://src/router/smart-router/router.ts#L1-L70",
          "version": "repo-lines-v1:sha256:c99a71bd59c3516a6edb2de16f473ad38c2ac5993ece46bafebe1fb1f3fe12dd:"
