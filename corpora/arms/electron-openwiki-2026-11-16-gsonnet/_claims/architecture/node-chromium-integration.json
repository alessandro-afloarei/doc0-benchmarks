    {
      "id": "claim_4b07a2de72fc4701a5a39ac25f1df2ea",
      "statement": "JoinAppCode (browser process only) pumps uv_run(UV_RUN_ONCE) until process.appCodeLoaded() sets app_code_loaded_, the browser is shutting down, or libuv has no more work.",
