    {
      "id": "claim_8b30fa90074f4a9e97abbd24d42c312a",
      "statement": "The webpack base config aliases @electron/internal to lib/ and all 'electron', 'electron/main', 'electron/renderer', 'electron/common' and 'electron/utility' specifiers to one per-target lib/<target>/api/exports/electron.ts, and replaces BUILDFLAG identifiers with booleans parsed from the generated buildflags.h so build-time features are compiled out of JS.",
      "evidence": [
        {
          "resource": "repo://build/webpack/webpack.config.base.js#L38-L130",
          "version": "repo-lines-v1:sha256:f5e5386319e99282bfb36ccaac1538ae0e428097b42cf558bc1ec6eacaa231c8:"
        }
      ]
    },
