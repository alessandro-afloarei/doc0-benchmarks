        {
          "resource": "repo://celery/app/base.py#L1534-L1607",
          "version": "repo-lines-v1:sha256:b5ee8ac477d35dd2bc734d92db77ab625324af7142d2ebb61f93074bc21ed084:"
        }
      ]
    },
    {
      "id": "claim_57c10a84e8864f2ba09e00477625316a",
      "statement": "Loader resolution checks the CELERY_LOADER environment variable first, then the loader_cls attribute or argument, and falls back to celery.loaders.app:AppLoader.",
