      "id": "claim_3b2731fcf5da4bb5afbc9b83ced98b43",
      "statement": "EventStream.add_event is the single write path: it rejects events that already have an ID, assigns the next integer ID under a lock, redacts known secrets before persisting or delivering, writes the event to the file store, and only then enqueues it for subscribers.",
      "evidence": [
        {
          "resource": "repo://openhands/events/stream.py#L163-L203",
          "version": "repo-lines-v1:sha256:063e3b88fd5605c787f9ce504d06274fe20033812fa35a706e057016aa4c1d12:"
        }
      ]
    },
    {
      "id": "claim_588ae17ba7304cb49618a158968a9dc3",
      "statement": "Secret redaction replaces known secret values in nested string fields but skips protected top-level metadata fields such as id, source, timestamp, and message.",
